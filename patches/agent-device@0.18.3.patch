+        try fileManager.removeItem(at: entry)
+        NSLog("AGENT_DEVICE_RUNNER_ARTIFACT_CLEANUP_REMOVED path=%@", entry.path)
+      } catch {
+        NSLog(
+          "AGENT_DEVICE_RUNNER_ARTIFACT_CLEANUP_REMOVE_FAILED path=%@ error=%@",
+          entry.path,
+          String(describing: error)
+        )
+      }
+    }
+  }
