@@ -0,0 +1,141 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  selectorSnapshot,
+  fillableSnapshot,
+  createInteractionDevice,
+  clickRefE2,
+} from './__tests__/test-utils/index.ts';
+import { ref, selector } from './selector-read-utils.ts';
+
+/**
+ * The actuation outcome report a runtime-resolved interaction constructs:
+ * the daemon-owned targeting/geometry facts derive from the resolution path,
+ * the platform-owned executor facts merge in from the backend result's
+ * actuation fragment, and the unmerged fragment never survives on the result.
+ */
+
+test('a selector press reports element targeting with daemon-snapshot geometry', async () => {
+  const device = createInteractionDevice(selectorSnapshot());
+
+  const result = await device.interactions.press(selector('label=Continue'), {
+    session: 'default',
+  });
+
+  assert.deepEqual(result.actuation, {
+    version: 1,
+    targeting: 'element',
+    geometry: 'daemon-snapshot',
+    executor: 'unknown',
+  });
+});
+
+test('the backend actuation fragment merges into the outcome and leaves the backend result', async () => {
+  const device = createInteractionDevice(selectorSnapshot(), {
+    tap: async () => ({
+      actuation: {
+        executor: 'android-adb-input',
+        mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+      },
+    }),
+  });
+
+  const result = await device.interactions.press(selector('label=Continue'), {
+    session: 'default',
+  });
+
+  assert.deepEqual(result.actuation, {
+    version: 1,
+    targeting: 'element',
+    geometry: 'daemon-snapshot',
+    executor: 'android-adb-input',
+    mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+  });
+  assert.equal(
+    result.backendResult && 'actuation' in result.backendResult,
+    false,
+    'the unmerged fragment must not survive on the backend result',
+  );
+});
+
+test('a malformed backend fragment is unknown executor, never a passthrough', async () => {
+  const device = createInteractionDevice(selectorSnapshot(), {
+    tap: async () => ({ actuation: { executor: 'adb-injected-everything' } }),
+  });
+
+  const result = await device.interactions.press(selector('label=Continue'), {
+    session: 'default',
+  });
+
+  assert.equal(result.actuation?.executor, 'unknown');
+  assert.equal(result.backendResult && 'actuation' in result.backendResult, false);
+});
+
+test('a delegated direct dispatch reports the coordinateFallback fact with its detail', async () => {
+  const device = createInteractionDevice(selectorSnapshot());
+
+  const result = await device.interactions.click(selector('label=Continue'), {
+    session: 'default',
+    directDelegation: { detail: 'COMMAND_FAILED' },
+  });
+
+  assert.deepEqual(result.actuation?.coordinateFallback, {
+    reason: 'direct-dispatch-delegated',
+    detail: 'COMMAND_FAILED',
+  });
+  assert.equal(result.actuation?.targeting, 'element');
+  assert.equal(result.actuation?.geometry, 'daemon-snapshot');
+});
+
+test('an undelagated runtime interaction carries no fallback facts', async () => {
+  const device = createInteractionDevice(selectorSnapshot());
+
+  const result = await device.interactions.click(selector('label=Continue'), {
+    session: 'default',
+  });
+
+  assert.equal(result.actuation?.coordinateFallback, undefined);
+  assert.equal(result.actuation?.mechanismFallback, undefined);
+});
+
+test('a native-ref click reports provider-element geometry', async () => {
+  const device = createInteractionDevice(selectorSnapshot(), {
+    platform: 'web',
+    tapTarget: async (_context, target) => ({ ref: target.ref.replace(/^@/, '') }),
+  });
+
+  const result = await clickRefE2(device);
+
+  assert.equal(result.actuation?.targeting, 'element');
+  assert.equal(result.actuation?.geometry, 'provider-element');
+});
+
+test('a longpress reports the merged actuation outcome', async () => {
+  const device = createInteractionDevice(selectorSnapshot(), {
+    longPress: async () => ({ actuation: { executor: 'android-uiautomation-helper' } }),
+  });
+
+  const result = await device.interactions.longPress(ref('@e1'), {
+    session: 'default',
+    durationMs: 500,
+  });
+
+  assert.deepEqual(result.actuation, {
+    version: 1,
+    targeting: 'element',
+    geometry: 'daemon-snapshot',
+    executor: 'android-uiautomation-helper',
+  });
+});
+
+test('a fill reports the merged actuation outcome', async () => {
+  const device = createInteractionDevice(fillableSnapshot(), {
+    fill: async () => ({ actuation: { executor: 'keyboard' } }),
+  });
+
+  const result = await device.interactions.fill(ref('@e1'), 'hello', { session: 'default' });
+
+  assert.equal(result.actuation?.targeting, 'element');
+  assert.equal(result.actuation?.geometry, 'daemon-snapshot');
+  assert.equal(result.actuation?.executor, 'keyboard');
+});
