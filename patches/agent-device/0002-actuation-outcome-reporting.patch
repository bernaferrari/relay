diff --git a/packages/platform-android/src/actuation-outcome.test.ts b/packages/platform-android/src/actuation-outcome.test.ts
new file mode 100644
index 000000000..088b24a61
--- /dev/null
+++ b/packages/platform-android/src/actuation-outcome.test.ts
@@ -0,0 +1,161 @@
+import { afterEach, expect, test } from 'vitest';
+import { withAndroidAdbProvider } from './adb-executor.ts';
+import { fillAndroid } from './text-input.ts';
+import { pressAndroid } from './input-actions.ts';
+import { readAndroidFillTargetBeforeMutation } from './fill-verification.ts';
+import { resetAndroidSnapshotHelperSessions } from './snapshot-helper-session-lifecycle.ts';
+import { createPersistentSnapshotHelperProvider } from './__tests__/snapshot-helper-session.fixtures.ts';
+import { ANDROID_SNAPSHOT_HELPER_FIXTURE_ARTIFACT } from './__tests__/test-utils/android-snapshot-helper.ts';
+import { ANDROID_EMULATOR as device } from './__tests__/test-utils/device-fixtures.ts';
+
+/**
+ * The platform-owned executor facts Android reports on its action results:
+ * which injector fired (the uiautomation helper or adb input), and the
+ * mechanismFallback fact when a live helper's input came back unconfirmed
+ * and adb substituted for it.
+ */
+
+afterEach(resetAndroidSnapshotHelperSessions);
+
+const helper = { helperSessionScope: 'daemon-session' } as const;
+
+function fixture(response: Record<string, string>) {
+  const calls: (readonly string[])[] = [];
+  const requests: string[] = [];
+  let value = '';
+  const provider = createPersistentSnapshotHelperProvider({
+    calls,
+    processes: [],
+    spawnArgs: [],
+    sessionRequests: requests,
+    sessionCommands: ['input', 'screenshot', 'focus', 'snapshot-immediate'],
+    sessionCommand: (command) => {
+      if (/^input /.test(command)) {
+        // The helper's fill writes its text into the focused field; the
+        // request rides as base64 JSON in the session frame.
+        const encoded = command.split(' ')[2];
+        if (encoded) {
+          try {
+            const payload = JSON.parse(Buffer.from(encoded, 'base64').toString('utf8')) as {
+              kind?: string;
+              text?: string;
+            };
+            if (payload.kind === 'fill' && typeof payload.text === 'string') {
+              value = payload.text;
+            }
+          } catch {
+            // Not a JSON payload frame — nothing lands in the field.
+          }
+        }
+        return response;
+      }
+      if (/^(screenshot|focus) /.test(command)) return response;
+      return undefined;
+    },
+    sessionXml: () =>
+      `<hierarchy><node package="com.example" resource-id="com.example:id/field" class="android.widget.EditText" focused="true" editable="true" text="${value}" bounds="[0,0][200,100]"/></hierarchy>`,
+  });
+  const exec = provider.exec;
+  provider.exec = async (args, options) => {
+    if (args[0] === 'shell' && args[1] === 'input') {
+      calls.push(args);
+      if (args[2] === 'text') value += args[3] ?? '';
+      if (args.includes('KEYCODE_DEL')) value = '';
+      return { exitCode: 0, stdout: '', stderr: '' };
+    }
+    return await exec(args, options);
+  };
+  return {
+    calls,
+    requests,
+    provider: { ...provider, snapshotHelperArtifact: ANDROID_SNAPSHOT_HELPER_FIXTURE_ARTIFACT },
+  };
+}
+
+const refused = {
+  ok: 'false',
+  errorType: 'java.lang.IllegalStateException',
+  message: 'No editable field at the fill point',
+  injected: 'false',
+};
+
+type ActuationFragment = {
+  executor?: string;
+  mechanismFallback?: { reason: string };
+};
+
+function fragmentOf(result: unknown): ActuationFragment | undefined {
+  if (!result || typeof result !== 'object') return undefined;
+  return (result as Record<string, unknown>).actuation as ActuationFragment | undefined;
+}
+
+test('a helper-confirmed press reports the uiautomation helper executor', async () => {
+  const f = fixture({ ok: 'true' });
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    await readAndroidFillTargetBeforeMutation(device, 10, 10, helper);
+    fragment = fragmentOf(await pressAndroid(device, 10, 10));
+  });
+  expect(fragment).toEqual({ executor: 'android-uiautomation-helper' });
+  expect(f.calls.some((args) => args[0] === 'shell' && args[2] === 'tap')).toBe(false);
+});
+
+test('an unconfirmed helper input reports adb input with the mechanismFallback fact', async () => {
+  const f = fixture(refused);
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    await readAndroidFillTargetBeforeMutation(device, 10, 10, helper);
+    fragment = fragmentOf(await pressAndroid(device, 10, 10));
+  });
+  expect(fragment).toEqual({
+    executor: 'android-adb-input',
+    mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+  });
+  expect(f.calls.filter((args) => args[0] === 'shell' && args[2] === 'tap')).toHaveLength(1);
+});
+
+test('a press without a live helper reports plain adb input, never a fallback', async () => {
+  const f = fixture({ ok: 'true' });
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    fragment = fragmentOf(await pressAndroid(device, 10, 10));
+  });
+  expect(fragment).toEqual({ executor: 'android-adb-input' });
+  expect(f.calls.filter((args) => args[0] === 'shell' && args[2] === 'tap')).toHaveLength(1);
+  expect(f.requests.some((request) => request.startsWith('input '))).toBe(false);
+});
+
+test('a helper-confirmed fill reports the uiautomation helper executor', async () => {
+  const f = fixture({ ok: 'true' });
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    fragment = fragmentOf(await fillAndroid(device, 10, 10, 'chips', 0, helper));
+  });
+  expect(fragment).toEqual({ executor: 'android-uiautomation-helper' });
+  expect(f.requests.some((request) => request.startsWith('input '))).toBe(true);
+  expect(f.calls.some((args) => args[0] === 'shell' && args[2] === 'text')).toBe(false);
+});
+
+test('a fill displaced to the shell writer by an unconfirmed helper reports both facts', async () => {
+  const f = fixture(refused);
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    await readAndroidFillTargetBeforeMutation(device, 10, 10, helper);
+    fragment = fragmentOf(await fillAndroid(device, 10, 10, 'chips', 0, helper));
+  });
+  expect(fragment).toEqual({
+    executor: 'android-adb-input',
+    mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+  });
+  expect(f.calls.some((args) => args[0] === 'shell' && args[2] === 'text')).toBe(true);
+});
+
+test('a delayed fill on the shell writer is the designed route, not a substitution', async () => {
+  const f = fixture({ ok: 'true' });
+  let fragment: ActuationFragment | undefined;
+  await withAndroidAdbProvider(f.provider, { serial: device.id }, async () => {
+    await readAndroidFillTargetBeforeMutation(device, 10, 10, helper);
+    fragment = fragmentOf(await fillAndroid(device, 10, 10, 'hi', 5, helper));
+  });
+  expect(fragment).toEqual({ executor: 'android-adb-input' });
+});
