+import { beforeEach, expect, test } from 'vitest';
+import { AppError } from '@agent-device/kernel/errors';
+import { makeSessionStore } from '../../../__tests__/support/store-factory.ts';
+import {
+  installInteractorSnapshotResolution,
+  mockInteractorSnapshot,
+} from '../../../__tests__/support/interactor-resolution-fixture.ts';
+import { runInteraction } from '../../../__tests__/support/touch-interaction-runner.ts';
+import {
+  getRuntimeBindings,
+  mockTapElementSelector,
+  mockTapPoint,
+  resetGetRuntimeFixture,
+} from '../../__tests__/interaction-get-runtime-fixture.ts';
+import { makeStaleRefSession, makeTwoButtonNodes } from './__tests__/interaction-touch-fixtures.ts';
+import { handleInteractionCommands } from '../index.ts';
+import { touchCreateCommandSurface } from '../../../__tests__/support/touch-command-surface-fake.ts';
+import { contextFromFlags } from './__tests__/interaction-touch-fixtures.ts';
+
+/**
+ * The actuation outcome report on interaction success responses: the daemon
+ * owns targeting/geometry for runtime-resolved interactions, a delegated
+ * direct dispatch discloses its coordinateFallback, and the direct runner
+ * payload path carries no report — the platform runner owns that outcome.
+ */
+
+beforeEach(() => {
+  resetGetRuntimeFixture();
+  installInteractorSnapshotResolution();
+  mockInteractorSnapshot.mockReset();
+});
+
+function publishTreeSession(
+  sessionStore: ReturnType<typeof makeSessionStore>,
+  sessionName: string,
+) {
+  sessionStore.publish(sessionName, makeStaleRefSession(sessionName));
+  mockInteractorSnapshot.mockResolvedValue({
+    nodes: makeTwoButtonNodes(),
+    backend: 'xctest',
+    producer: 'apple-runner',
+  });
+}
+
+test('a selector press reports element targeting with daemon-snapshot geometry', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-selector-press';
+  publishTreeSession(sessionStore, sessionName);
+
+  const response = await runInteraction(sessionStore, sessionName, 'press', ['label=Continue']);
+
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  expect(response.data?.actuation).toEqual({
+    version: 1,
+    targeting: 'element',
+    geometry: 'daemon-snapshot',
+    executor: 'unknown',
+  });
+});
+
+test('a point press reports point targeting with caller-point geometry', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-point-press';
+  publishTreeSession(sessionStore, sessionName);
+
+  const response = await runInteraction(sessionStore, sessionName, 'press', ['100', '200']);
+
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  expect(response.data?.actuation).toEqual({
+    version: 1,
+    targeting: 'point',
+    geometry: 'caller-point',
+    executor: 'unknown',
+  });
+});
+
+test('a direct-dispatch delegation reports its coordinateFallback reason and detail', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-direct-delegation';
+  publishTreeSession(sessionStore, sessionName);
+  mockTapElementSelector.mockRejectedValueOnce(
+    new AppError('COMMAND_FAILED', 'Runner did not accept connection', {
+      runnerConnectFailureReason: 'runner_connect_refused',
+      dispatched: 'no',
+    }),
+  );
+
+  const response = await runInteraction(sessionStore, sessionName, 'click', ['label=Continue'], {
+    maestro: { allowNonHittableCoordinateFallback: true },
+  });
+
+  expect(mockTapElementSelector).toHaveBeenCalledOnce();
+  expect(mockTapPoint).toHaveBeenCalledOnce();
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  const actuation = response.data?.actuation as Record<string, unknown> | undefined;
+  expect(actuation?.targeting).toBe('element');
+  expect(actuation?.geometry).toBe('daemon-snapshot');
+  expect(actuation?.coordinateFallback).toEqual({
+    reason: 'direct-dispatch-delegated',
+    detail: 'COMMAND_FAILED',
+  });
+});
+
+test('an undelegated selector click carries no fallback facts', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-no-fallbacks';
+  publishTreeSession(sessionStore, sessionName);
+
+  const response = await runInteraction(sessionStore, sessionName, 'click', ['label=Continue'], {
+    maestro: { allowNonHittableCoordinateFallback: true },
+  });
+
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  const actuation = response.data?.actuation as Record<string, unknown> | undefined;
+  expect(actuation?.coordinateFallback).toBeUndefined();
+  expect(actuation?.mechanismFallback).toBeUndefined();
+});
+
+test('the direct runner payload path carries no actuation report', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-direct-success';
+  publishTreeSession(sessionStore, sessionName);
+  mockTapElementSelector.mockResolvedValueOnce({ x: 60, y: 40 });
+
+  const response = await runInteraction(sessionStore, sessionName, 'click', ['label=Continue'], {
+    maestro: { allowNonHittableCoordinateFallback: true },
+  });
+
+  expect(mockTapElementSelector).toHaveBeenCalledOnce();
+  expect(mockTapPoint).not.toHaveBeenCalled();
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  expect(response.data?.actuation).toBeUndefined();
+});
+
+test('the backend actuation fragment merges into the response outcome', async () => {
+  const sessionStore = makeSessionStore();
+  const sessionName = 'actuation-fragment-merge';
+  publishTreeSession(sessionStore, sessionName);
+  mockTapPoint.mockImplementationOnce(async (input) => ({
+    x: input.point.x,
+    y: input.point.y,
+    actuation: {
+      executor: 'android-adb-input',
+      mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+    },
+  }));
+
+  const response = await handleInteractionCommands({
+    createCommandSurface: touchCreateCommandSurface,
+    req: {
+      token: 't',
+      session: sessionName,
+      command: 'press',
+      positionals: ['label=Continue'],
+      flags: {},
+    },
+    sessionName,
+    sessionStore,
+    contextFromFlags,
+    ...getRuntimeBindings(),
+  });
+
+  expect(response?.ok).toBe(true);
+  if (!response?.ok) return;
+  expect(response.data?.actuation).toEqual({
+    version: 1,
+    targeting: 'element',
+    geometry: 'daemon-snapshot',
+    executor: 'android-adb-input',
+    mechanismFallback: { reason: 'automation-helper-input-not-confirmed' },
+  });
+});
