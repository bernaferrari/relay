@@ -0,0 +1,117 @@
+import {
+  ACTUATION_COORDINATE_FALLBACK_DIRECT_DELEGATED,
+  ACTUATION_OUTCOME_VERSION,
+  type ActuationBackendFragment,
+  type ActuationExecutor,
+  type ActuationGeometry,
+  type ActuationOutcome,
+  type ActuationTargeting,
+} from '@agent-device/contracts/actuation-outcome';
+import type { ResolvedInteractionTarget } from '@agent-device/contracts/interaction';
+
+/**
+ * Construction of the actuation outcome report for runtime-resolved
+ * interactions. The daemon owns targeting/geometry here — they derive from
+ * the resolution path the interaction just took — while the platform backend
+ * owns executor/mechanism facts, which arrive as a fragment on the backend
+ * result under the `actuation` key. The fragment is consumed into the merged
+ * outcome and stripped from the backend result so the unmerged partial shape
+ * never reaches a response.
+ */
+
+const ACTUATION_EXECUTORS: ReadonlySet<string> = new Set<ActuationExecutor>([
+  'xctest-element-coordinate',
+  'xctest-coordinate',
+  'xctest-synthesized-touch',
+  'android-adb-input',
+  'android-uiautomation-helper',
+  'android-provider-native',
+  'provider-native',
+  'keyboard',
+  'unknown',
+]);
+
+/** The fragment a backend reported on its action result, or undefined when absent or malformed. */
+export function extractActuationBackendFragment(
+  backendResult: Record<string, unknown> | undefined,
+): ActuationBackendFragment | undefined {
+  const raw = backendResult?.actuation;
+  if (!raw || typeof raw !== 'object') return undefined;
+  const candidate = raw as Record<string, unknown>;
+  if (typeof candidate.executor !== 'string' || !ACTUATION_EXECUTORS.has(candidate.executor)) {
+    return undefined;
+  }
+  const mechanismFallback = readFallbackFact(candidate.mechanismFallback);
+  return {
+    executor: candidate.executor as ActuationExecutor,
+    ...(typeof candidate.executorDetail === 'string'
+      ? { executorDetail: candidate.executorDetail }
+      : {}),
+    ...(mechanismFallback ? { mechanismFallback } : {}),
+  };
+}
+
+/** The backend result minus the consumed fragment key; the input object is not mutated. */
+export function stripActuationBackendFragment(
+  backendResult: Record<string, unknown> | undefined,
+): Record<string, unknown> | undefined {
+  if (!backendResult || !('actuation' in backendResult)) return backendResult;
+  const { actuation: _consumed, ...rest } = backendResult;
+  return rest;
+}
+
+function readFallbackFact(raw: unknown): { reason: string; detail?: string } | undefined {
+  if (!raw || typeof raw !== 'object') return undefined;
+  const candidate = raw as Record<string, unknown>;
+  if (typeof candidate.reason !== 'string' || candidate.reason.length === 0) return undefined;
+  return {
+    reason: candidate.reason,
+    ...(typeof candidate.detail === 'string' ? { detail: candidate.detail } : {}),
+  };
+}
+
+/**
+ * Targeting/geometry for a runtime-resolved interaction: a point target is
+ * caller geometry by construction, an element target resolved through the
+ * daemon's tree is daemon-snapshot geometry. The native-ref fast path
+ * overrides geometry to `provider-element` — the provider's own element
+ * handle actuated without a derived point.
+ */
+export function actuationTargetingGeometry(
+  resolved: ResolvedInteractionTarget,
+  geometryOverride?: ActuationGeometry,
+): { targeting: ActuationTargeting; geometry: ActuationGeometry } {
+  if (resolved.kind === 'point') return { targeting: 'point', geometry: 'caller-point' };
+  return { targeting: 'element', geometry: geometryOverride ?? 'daemon-snapshot' };
+}
+
+export function buildInteractionActuation(params: {
+  targeting: ActuationTargeting;
+  geometry: ActuationGeometry;
+  backendResult?: Record<string, unknown>;
+  /**
+   * The refused direct platform dispatch this runtime interaction delegates
+   * for. Present only when the semantic target was meant to actuate through
+   * a direct platform dispatch and became numeric input instead; `detail`
+   * carries the refusal's error code when one was disclosed.
+   */
+  directDelegation?: { detail?: string };
+}): ActuationOutcome {
+  const fragment = extractActuationBackendFragment(params.backendResult);
+  return {
+    version: ACTUATION_OUTCOME_VERSION,
+    targeting: params.targeting,
+    geometry: params.geometry,
+    executor: fragment?.executor ?? 'unknown',
+    ...(fragment?.executorDetail ? { executorDetail: fragment.executorDetail } : {}),
+    ...(params.directDelegation
+      ? {
+          coordinateFallback: {
+            reason: ACTUATION_COORDINATE_FALLBACK_DIRECT_DELEGATED,
+            ...(params.directDelegation.detail ? { detail: params.directDelegation.detail } : {}),
+          },
+        }
+      : {}),
+    ...(fragment?.mechanismFallback ? { mechanismFallback: fragment.mechanismFallback } : {}),
+  };
+}
