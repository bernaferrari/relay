diff --git a/packages/contracts/src/actuation-outcome.ts b/packages/contracts/src/actuation-outcome.ts
new file mode 100644
index 000000000..d0d192515
--- /dev/null
+++ b/packages/contracts/src/actuation-outcome.ts
@@ -0,0 +1,84 @@
+/**
+ * Actuation outcome reporting: for every actuating interaction success, the
+ * response MAY carry an additive `actuation` object describing three
+ * orthogonal facts of the dispatch that just happened:
+ *
+ * - `targeting`: who chose the target — an element reference/selector, a
+ *   numeric point, or a direct platform dispatch with no daemon-side target
+ *   resolution.
+ * - `geometry`: whose geometry the actuated position came from. The frames a
+ *   consumer captured before dispatch are frozen geometry; a frame the
+ *   platform read at execution time is fresh. `none` means no geometry
+ *   participated (for example a direct keypress injection).
+ * - `executor`: which injector performed the input.
+ *
+ * The three axes compose. `coordinateFallback` and `mechanismFallback` are two
+ * deliberately separate substitution facts: the first means a semantic target
+ * became numeric input contrary to the attempted actuation mode, the second
+ * means one injector substituted for another. Ownership is split: the daemon
+ * owns targeting/geometry for runtime-resolved interactions, the platform
+ * backend owns executor/mechanism facts. Fields absent from the object are
+ * unknown — absence never upgrades to a purer reading.
+ */
+export const ACTUATION_OUTCOME_VERSION = 1;
+
+export type ActuationTargeting = 'element' | 'point' | 'direct';
+
+export type ActuationGeometry =
+  | 'none'
+  | 'runner-element-frame'
+  | 'runner-expected-point'
+  | 'daemon-snapshot'
+  | 'relay-snapshot'
+  | 'caller-point'
+  | 'provider-element'
+  | 'unknown';
+
+export type ActuationExecutor =
+  | 'xctest-element-coordinate'
+  | 'xctest-coordinate'
+  | 'xctest-synthesized-touch'
+  | 'android-adb-input'
+  | 'android-uiautomation-helper'
+  | 'android-provider-native'
+  | 'provider-native'
+  | 'keyboard'
+  | 'unknown';
+
+/**
+ * A typed substitution fact. `reason` is the typed category; `detail` carries
+ * an optional machine-readable refinement (for example the refused dispatch's
+ * error code).
+ */
+export type ActuationFallback = {
+  reason: string;
+  detail?: string;
+};
+
+/** A direct platform dispatch attempt delegated to runtime resolution, so the semantic target was actuated through numeric input. */
+export const ACTUATION_COORDINATE_FALLBACK_DIRECT_DELEGATED = 'direct-dispatch-delegated';
+
+/** A live preferred injector did not confirm the input, so a lesser injector substituted for it. */
+export const ACTUATION_MECHANISM_FALLBACK_HELPER_INPUT_NOT_CONFIRMED =
+  'automation-helper-input-not-confirmed';
+
+export type ActuationOutcome = {
+  version: number;
+  targeting: ActuationTargeting;
+  geometry: ActuationGeometry;
+  executor: ActuationExecutor;
+  executorDetail?: string;
+  coordinateFallback?: ActuationFallback;
+  mechanismFallback?: ActuationFallback;
+};
+
+/**
+ * The platform-owned slice of an actuation outcome. Backends attach this
+ * fragment to their action results under the `actuation` key; the command
+ * runtime consumes and merges it into the complete outcome and never exposes
+ * the unmerged fragment on a response.
+ */
+export type ActuationBackendFragment = Pick<
+  ActuationOutcome,
+  'executor' | 'executorDetail' | 'mechanismFallback'
+>;
