+    await finishRegisteredDaemonFixture(stateDir);
+    mockRunCmdDetached.mockClear();
+    mockRunCmdDetached.mockImplementationOnce(() => {
+      throw new Error('first launch failed');
+    });
+    mockRunCmdDetached.mockImplementationOnce(() => {
