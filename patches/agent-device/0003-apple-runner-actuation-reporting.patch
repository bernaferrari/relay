+/// The additive actuation outcome vocabulary shared with the daemon contract. Every axis is
+/// optional on the wire because the reporter owns different slices of it: a coordinate command can
+/// prove only its executor, while a runner-resolved selector command can also prove the geometry
+/// its resolution used. Absent means unknown, never a purer fact.
+enum ActuationOutcomeTargeting: String, Codable {
+  case element
+  case point
+  case direct
+}
+
+enum ActuationOutcomeGeometry: String, Codable {
+  case none
+  case runnerElementFrame = "runner-element-frame"
+  case runnerExpectedPoint = "runner-expected-point"
+  case daemonSnapshot = "daemon-snapshot"
+  case relaySnapshot = "relay-snapshot"
+  case callerPoint = "caller-point"
+  case providerElement = "provider-element"
+  case unknown
+}
+
+enum ActuationOutcomeExecutor: String, Codable {
+  case xctestElementCoordinate = "xctest-element-coordinate"
+  case xctestCoordinate = "xctest-coordinate"
+  case xctestSynthesizedTouch = "xctest-synthesized-touch"
+  case androidAdbInput = "android-adb-input"
+  case androidUiautomationHelper = "android-uiautomation-helper"
+  case androidProviderNative = "android-provider-native"
+  case providerNative = "provider-native"
+  case keyboard
+  case unknown
+}
+
+struct ActuationFallbackPayload: Codable, Equatable {
+  let reason: String
+  let detail: String?
+
+  init(reason: String, detail: String? = nil) {
+    self.reason = reason
+    self.detail = detail
+  }
+}
+
+struct ActuationOutcomePayload: Codable, Equatable {
+  let version: Int
+  let targeting: ActuationOutcomeTargeting?
+  let geometry: ActuationOutcomeGeometry?
+  let executor: ActuationOutcomeExecutor?
+  let executorDetail: String?
+  let coordinateFallback: ActuationFallbackPayload?
+  let mechanismFallback: ActuationFallbackPayload?
+
+  init(
+    version: Int = 1,
+    targeting: ActuationOutcomeTargeting? = nil,
+    geometry: ActuationOutcomeGeometry? = nil,
+    executor: ActuationOutcomeExecutor? = nil,
+    executorDetail: String? = nil,
+    coordinateFallback: ActuationFallbackPayload? = nil,
+    mechanismFallback: ActuationFallbackPayload? = nil
+  ) {
+    self.version = version
+    self.targeting = targeting
+    self.geometry = geometry
+    self.executor = executor
+    self.executorDetail = executorDetail
+    self.coordinateFallback = coordinateFallback
+    self.mechanismFallback = mechanismFallback
+  }
+}
+
+enum RunnerActuationFallbackReason {
+  /// A runner-resolved semantic target was actuated at a point because XCTest marked it non-hittable.
+  static let nonHittableCoordinate = "non-hittable-coordinate"
+  /// A runner-resolved semantic target was actuated at the externally supplied expected point.
+  static let expectedPointCoordinate = "expected-point-coordinate"
+  /// The synthesized-touch injector could not be used, so an XCTest coordinate injected the input.
+  static let synthesizedTouchUnavailable = "synthesized-touch-unavailable"
+}
+
