diff --git a/packages/daemon/src/execution/interaction/internal/interaction-actuation-runner.ts b/packages/daemon/src/execution/interaction/internal/interaction-actuation-runner.ts
new file mode 100644
index 000000000..88821e89a
--- /dev/null
+++ b/packages/daemon/src/execution/interaction/internal/interaction-actuation-runner.ts
@@ -0,0 +1,128 @@
+import {
+  ACTUATION_COORDINATE_FALLBACK_EXPECTED_POINT,
+  ACTUATION_COORDINATE_FALLBACK_NON_HITTABLE_COORDINATE,
+  ACTUATION_OUTCOME_VERSION,
+  type ActuationExecutor,
+  type ActuationFallback,
+  type ActuationGeometry,
+  type ActuationOutcome,
+  type ActuationTargeting,
+} from '@agent-device/contracts/actuation-outcome';
+
+/**
+ * Defensive decoding and ownership merge for the additive actuation object an
+ * Apple runner may return. The runner wire is untrusted JSON: every field is
+ * validated independently, unknown future vocabulary is ignored rather than
+ * echoed, and a malformed slice never invalidates the facts the daemon itself
+ * owns. Absence remains unknown; it is never treated as a purer outcome.
+ */
+
+const TARGETINGS = ['element', 'point', 'direct'] as const;
+const GEOMETRIES = [
+  'none',
+  'runner-element-frame',
+  'runner-expected-point',
+  'daemon-snapshot',
+  'relay-snapshot',
+  'caller-point',
+  'provider-element',
+  'unknown',
+] as const;
+const EXECUTORS = [
+  'xctest-element-coordinate',
+  'xctest-coordinate',
+  'xctest-synthesized-touch',
+  'android-adb-input',
+  'android-uiautomation-helper',
+  'android-provider-native',
+  'provider-native',
+  'keyboard',
+  'unknown',
+] as const;
+
+type RunnerActuationReport = {
+  targeting?: ActuationTargeting;
+  geometry?: ActuationGeometry;
+  executor?: ActuationExecutor;
+  executorDetail?: string;
+  coordinateFallback?: ActuationFallback;
+  mechanismFallback?: ActuationFallback;
+};
+
+/** Decode the independently valid slices of an untrusted runner `actuation` object. */
+export function parseRunnerActuationReport(value: unknown): RunnerActuationReport | undefined {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
+  const report = value as Record<string, unknown>;
+  const targeting = readUnion(report.targeting, TARGETINGS);
+  const geometry = readUnion(report.geometry, GEOMETRIES);
+  const executor = readUnion(report.executor, EXECUTORS);
+  const executorDetail =
+    typeof report.executorDetail === 'string' ? report.executorDetail : undefined;
+  const coordinateFallback = readFallback(report.coordinateFallback);
+  const mechanismFallback = readFallback(report.mechanismFallback);
+  if (
+    targeting === undefined &&
+    geometry === undefined &&
+    executor === undefined &&
+    executorDetail === undefined &&
+    coordinateFallback === undefined &&
+    mechanismFallback === undefined
+  ) {
+    return undefined;
+  }
+  return { targeting, geometry, executor, executorDetail, coordinateFallback, mechanismFallback };
+}
+
+/**
+ * Build the complete outcome for the direct-selector runner route. The daemon
+ * owns the semantic-targeting fact because the route exists only for a selector
+ * command. The runner owns how it resolved and injected that target. The
+ * fallback facts the daemon can derive from the request are defaults only —
+ * runner evidence, when valid, wins because the outcome is runner-internal.
+ */
+export function mergeDirectIosRunnerActuation(params: {
+  report: unknown;
+  expectedPointSupplied: boolean;
+  usedNonHittableCoordinateFallback: boolean;
+}): ActuationOutcome {
+  const runner = parseRunnerActuationReport(params.report);
+  const expectedPointGeometryConsistent =
+    runner?.geometry === undefined ||
+    runner.geometry === 'runner-expected-point' ||
+    runner.geometry === 'unknown';
+  const inferredCoordinateFallback = params.usedNonHittableCoordinateFallback
+    ? { reason: ACTUATION_COORDINATE_FALLBACK_NON_HITTABLE_COORDINATE }
+    : params.expectedPointSupplied && expectedPointGeometryConsistent
+      ? { reason: ACTUATION_COORDINATE_FALLBACK_EXPECTED_POINT }
+      : undefined;
+  return stripUndefinedActuationFields({
+    version: ACTUATION_OUTCOME_VERSION,
+    targeting: 'element',
+    geometry: runner?.geometry ?? 'unknown',
+    executor: runner?.executor ?? 'unknown',
+    executorDetail: runner?.executorDetail,
+    coordinateFallback: runner?.coordinateFallback ?? inferredCoordinateFallback,
+    mechanismFallback: runner?.mechanismFallback,
+  });
+}
+
+function readUnion<T extends string>(value: unknown, values: readonly T[]): T | undefined {
+  return typeof value === 'string' && (values as readonly string[]).includes(value)
+    ? (value as T)
+    : undefined;
+}
+
+function readFallback(value: unknown): ActuationFallback | undefined {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
+  const fallback = value as Record<string, unknown>;
+  if (typeof fallback.reason !== 'string' || fallback.reason.length === 0) return undefined;
+  return typeof fallback.detail === 'string'
+    ? { reason: fallback.reason, detail: fallback.detail }
+    : { reason: fallback.reason };
+}
+
+function stripUndefinedActuationFields(outcome: ActuationOutcome): ActuationOutcome {
+  return Object.fromEntries(
+    Object.entries(outcome).filter(([, value]) => value !== undefined),
+  ) as ActuationOutcome;
+}
