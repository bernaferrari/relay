+/**
+ * Narrow the backend-owned slice of a runner actuation report. The runner also
+ * owns targeting/geometry on some direct-selector commands, but a type response
+ * reaches this boundary as backend evidence only; those axes belong to the
+ * runtime that chose the insertion target and are deliberately not echoed here.
+ */
+function readActuationBackendFragment(value: unknown): ActuationBackendFragment | undefined {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
+  const candidate = value as Record<string, unknown>;
+  if (
+    typeof candidate.executor !== 'string' ||
+    !(ACTUATION_EXECUTORS as readonly string[]).includes(candidate.executor)
+  ) {
+    return undefined;
+  }
+  const mechanismFallback = readActuationFallback(candidate.mechanismFallback);
+  return {
+    executor: candidate.executor as ActuationExecutor,
+    ...(typeof candidate.executorDetail === 'string'
+      ? { executorDetail: candidate.executorDetail }
+      : {}),
+    ...(mechanismFallback ? { mechanismFallback } : {}),
+  };
+}
+
+function readActuationFallback(value: unknown): { reason: string; detail?: string } | undefined {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
+  const candidate = value as Record<string, unknown>;
+  if (typeof candidate.reason !== 'string' || candidate.reason.length === 0) return undefined;
+  return {
+    reason: candidate.reason,
+    ...(typeof candidate.detail === 'string' ? { detail: candidate.detail } : {}),
