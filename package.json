{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — record, automate, and inspect mobile app tests on real devices",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @relay/cli exec tsx src/index.ts",
    "dev:cli": "pnpm --filter @relay/cli exec tsx src/index.ts",
    "dev:tui": "pnpm --filter @relay/tui dev",
    "dev:serve": "pnpm --filter @relay/server dev",
    "ensure:serve": "node scripts/ensure-server.mjs",
    "dev:mcp": "pnpm --filter @relay/mcp start",
    "dev:app": "pnpm --filter @relay/app dev",
    "dev:desktop": "pnpm --filter @relay/desktop dev",
    "relay": "pnpm --filter @relay/cli exec tsx src/index.ts",
    "inspect:desktop": "pnpm --filter @relay/desktop inspect",
    "agent-device:install": "cd vendor/agent-device && pnpm install --frozen-lockfile --ignore-scripts",
    "agent-device:build": "node scripts/build-agent-device.mjs",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "pack": "vp pack",
    "prepare": "vp config",
    "doctor": "pnpm --filter @relay/cli exec tsx src/index.ts system doctor",
    "test": "pnpm run test:packages && vp test",
    "test:packages": "pnpm -r --if-present run test",
    "test:golden": "node scripts/golden-device.mjs",
    "test:golden:require": "GOLDEN_REQUIRE_DEVICE=1 node scripts/golden-device.mjs",
    "test:architecture": "node --test scripts/check-source-budgets.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-source-budgets.mjs",
    "verify": "vp check && pnpm run check:docs && pnpm run check:architecture && pnpm run test:architecture && pnpm typecheck && pnpm run test:packages && vp test && pnpm --filter @relay/app check:ui && pnpm --filter @relay/app build && pnpm --filter @relay/desktop build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
