{
  "name": "grok-device",
  "version": "0.1.0",
  "private": true,
  "description": "Grok Android device actions — CLI, TUI, and desktop (agent-device SDK)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @grok-device/cli exec tsx src/index.ts",
    "dev:cli": "pnpm --filter @grok-device/cli exec tsx src/index.ts",
    "dev:tui": "pnpm --filter @grok-device/cli exec tsx src/index.ts tui",
    "dev:serve": "pnpm --filter @grok-device/cli exec tsx src/index.ts serve",
    "dev:app": "pnpm --filter @grok-device/app dev",
    "dev:desktop": "pnpm --filter @grok-device/desktop dev",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "pack": "vp pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
