{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — record, automate, and inspect mobile app tests on real devices",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @relay/cli exec tsx src/index.ts",
    "dev:cli": "pnpm --filter @relay/cli exec tsx src/index.ts",
    "dev:tui": "pnpm --filter @relay/cli exec tsx src/index.ts tui",
    "dev:serve": "pnpm --filter @relay/cli exec tsx src/index.ts serve",
    "dev:app": "pnpm --filter @relay/app dev",
    "dev:desktop": "pnpm --filter @relay/desktop dev",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "pack": "vp pack",
    "prepare": "vp config",
    "doctor": "pnpm --filter @relay/cli exec tsx src/index.ts doctor",
    "test": "pnpm --filter @relay/core test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
