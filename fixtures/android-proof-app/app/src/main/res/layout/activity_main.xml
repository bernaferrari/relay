<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/proof_scroll"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/relay_background"
  android:clipToPadding="false"
  android:fillViewport="true">

  <LinearLayout
    android:id="@+id/proof_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="48dp"
    android:paddingRight="24dp"
    android:paddingBottom="32dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.12"
      android:text="@string/eyebrow"
      android:textColor="@color/relay_blue"
      android:textSize="12sp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:fontFamily="sans-serif-medium"
      android:text="@string/title"
      android:textColor="@color/relay_text"
      android:textSize="30sp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:lineSpacingExtra="3dp"
      android:text="@string/description"
      android:textColor="@color/relay_muted"
      android:textSize="16sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:background="@drawable/proof_card"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="CHECKPOINT"
        android:textColor="@color/relay_muted"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/proof_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ready"
        android:textColor="@color/relay_text"
        android:textSize="22sp" />

      <Button
        android:id="@+id/prove_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/proof_button"
        android:contentDescription="Prove interaction and show the passed checkpoint"
        android:fontFamily="sans-serif-medium"
        android:text="@string/prove"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

      <Button
        android:id="@+id/reset_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/reset_button"
        android:contentDescription="Reset the fixture checkpoint"
        android:fontFamily="sans-serif-medium"
        android:text="@string/reset"
        android:textAllCaps="false"
        android:textColor="@color/relay_text"
        android:textSize="15sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/build_identity"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:gravity="center"
      android:text="@string/build_identity"
      android:textColor="@color/relay_muted"
      android:textSize="13sp" />
  </LinearLayout>
</ScrollView>
