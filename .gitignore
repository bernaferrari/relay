# Local device tooling and dogfood artifacts. These are installed or captured
# per machine; committing them adds binaries, nested Git history, and secrets.
vendor/go-ios/
vendor/opencode-agentboard
devimages/
tmp/
selfIdentity.plist

# Local capture dumps: survey mosaics, preview marks, map export JSON, visual-pending
# review PNGs. Matches `.tmp/` at any package level (e.g. packages/server/.tmp/).
# Keep files on disk for human review; do not ship them. App Map source of truth lives
# in `.relay/control.sqlite`, not in these export dumps.
.tmp/

# Stray control-plane copies (canonical store is `.relay/control.sqlite`, already ignored).
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Apple / Xcode local build products (runner DerivedData, user state).
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult

# In-tree HID helper if someone builds beside sources (canonical binary is `.relay/bin/`).
packages/ios-hid-tap/ios-hid-tap
packages/ios-hid-tap/ios-hid-tap.exe

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# Local-only review artifacts: kept on disk, never pushed.
evidence/

# Editor/agent local state. Do not ship.
.claude/
.cursor/

# Managed worktrees are independent checkouts, not root workspace source.
# git worktrees (e.g. .worktrees/next-feature)
.worktrees/

# Local plans and product docs. Kept on disk only.
/docs/
/plans/
packages/ios-preview-producer/ios-preview-producer
