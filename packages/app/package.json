  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "happy-dom": "^20.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.14"
