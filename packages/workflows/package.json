{
  "name": "@relay/workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./outcomes": "./src/outcome-jobs.ts",
    "./run-outcomes": "./src/run-outcome-jobs.ts",
    "./operation-port": "./src/operation-port.ts",
    "./proof": "./src/proof-workflow.ts",
    "./recording-outcomes": "./src/recording-outcome-jobs.ts",
    "./recorded-step-presentation": "./src/recorded-step-presentation.ts",
    "./target-catalog": "./src/target-catalog.ts",
    "./types": "./src/types.ts",
    "./testing": "./src/testing.ts",
    "./task-guides": "./src/task-guides.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov src/*.test.ts"
  },
  "dependencies": {
    "@relay/core": "workspace:*",
    "@relay/protocol": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
