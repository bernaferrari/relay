{
  "name": "@relay/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Packaged canonical Relay service and safe local startup",
  "license": "MIT",
  "bin": {
    "relay-runtime": "dist/relay-runtime.js"
  },
  "files": [
    "dist/agent-device",
    "dist/manifest.json",
    "dist/relay-runtime.js",
    "dist/screenshot-analysis-worker.cjs",
    "dist/server.js",
    "dist/startup.d.ts",
    "dist/startup.js",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./startup": {
      "types": "./dist/startup.d.ts",
      "import": "./dist/startup.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test src/startup.test.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "setup:android": "fetch-scrcpy-server 2.5",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/google": "4.0.122",
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/fetch-scrcpy-server": "1.0.0",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/stream-extra": "2.6.1",
    "ai": "^7.0.133",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
