{
  "name": "@relay/mcp",
  "version": "0.1.0",
  "bin": {
    "relay-mcp": "./dist/relay-mcp.js",
    "relay-mcp-bridge": "./dist/relay-mcp-bridge.js",
    "relay-proof-doctor": "./dist/relay-proof-doctor.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js",
      "default": "./dist/prompts.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor-lib.js",
      "default": "./dist/doctor-lib.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/relay-mcp.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/*.test.ts",
    "test:clean-host": "node scripts/test-clean-host.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@relay/client": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/workflows": "workspace:*",
    "@types/node": "^26.5.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
