{
  "name": "@relay/mcp",
  "version": "0.1.0",
  "bin": {
    "relay-mcp": "./src/index.ts",
    "relay-proof-doctor": "./src/doctor-cli.ts"
  },
  "files": [
    "README.md",
    "src/config.ts",
    "src/diff-impact-resource.ts",
    "src/doctor-cli.ts",
    "src/doctor.ts",
    "src/errors.ts",
    "src/index.ts",
    "src/offline-replay-result.ts",
    "src/outcome-tools.ts",
    "src/prompts.ts",
    "src/repair-proposals-resource.ts",
    "src/resources.ts",
    "src/server.ts",
    "src/tools.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./config": "./src/config.ts",
    "./prompts": "./src/prompts.ts",
    "./doctor": "./src/doctor.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@relay/client": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/workflows": "workspace:*",
    "tsx": "^4.23.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
