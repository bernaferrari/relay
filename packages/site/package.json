{
  "name": "@relay/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-brand-assets.mjs && node --env-file-if-exists=.env.local scripts/prepare-content.mjs && next dev --hostname 127.0.0.1 --port 3002",
    "build": "node scripts/prepare-brand-assets.mjs && node --env-file-if-exists=.env.local scripts/prepare-content.mjs && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@relay/ui-react": "workspace:*",
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:"
  }
}
