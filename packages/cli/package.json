{
  "name": "@relay/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "relay": "./src/index.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@relay/core": "workspace:*",
    "@relay/server": "workspace:*",
    "@relay/tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.0",
    "typescript": "catalog:"
  }
}
