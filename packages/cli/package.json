{
  "name": "@relay/cli",
  "version": "0.1.0",
  "description": "Relay command-line interface for local-first product verification",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernaferrari/relay.git",
    "directory": "packages/cli"
  },
  "bin": {
    "relay": "./dist/relay.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.{ts,mjs}\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov \"src/**/*.test.ts\"",
    "test:clean-host": "node scripts/test-clean-host.mjs"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/fetch-scrcpy-server": "1.0.0",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/stream-extra": "2.6.1",
    "ai": "^7.0.133",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@relay/client": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/product": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/workflow-runners": "workspace:*",
    "@relay/workflows": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
