{
  "name": "@relay/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/components/*.tsx",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*.ts",
    "./theme/context": "./src/theme/context.tsx",
    "./theme/preload": "./src/theme/preload.js",
    "./theme/v2/*": "./src/theme/v2/*.ts",
    "./styles": "./src/styles/index.css",
    "./styles/tailwind": "./src/styles/tailwind/index.css",
    "./v2/styles/*": "./src/v2/styles/*",
    "./context/helper": "./src/context/helper.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
