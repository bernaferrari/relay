{
  "name": "@relay/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Record, edit, and run mobile and browser journeys with Relay.",
  "author": "Relay",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "inspect": "node scripts/inspect.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && electron-builder --mac dir",
    "dist": "node scripts/build.mjs && electron-builder --mac dmg zip",
    "preview": "node scripts/build.mjs && electron .",
    "test": "node --experimental-strip-types --test src/main/server-readiness.test.ts && node scripts/verify-server-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@relay/app": "workspace:*",
    "@relay/ui": "workspace:*",
    "playwright-core": "^1.61.1",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "^26.1.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "4.1.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.6"
  },
  "build": {
    "appId": "dev.relay.desktop",
    "productName": "Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/server",
        "to": "server"
      },
      {
        "from": "out/package.json",
        "to": "package.json"
      },
      {
        "from": "out/browsers.json",
        "to": "browsers.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/relay-icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Relay ${version}"
    }
  },
  "productName": "Relay"
}
