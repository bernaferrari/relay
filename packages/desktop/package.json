{
  "name": "@relay/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Map, verify, and run mobile and browser applications with Relay.",
  "author": "Relay",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "inspect": "node scripts/inspect.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/sign-mac-dist.mjs --mac dir",
    "dist": "node scripts/build.mjs && node scripts/sign-mac-dist.mjs --mac dmg zip",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "test": "node --experimental-strip-types --test src/main/server-readiness.test.ts src/main/ios-preview-sidecar.test.ts src/main/window-state.test.ts src/main/windows-launcher.test.ts src/main/lane-session.test.ts && node --test scripts/ensure-dev-service.test.mjs scripts/dev-app-entry.test.mjs scripts/ensure-electron-binary.test.mjs scripts/macos-icon-packaging.test.mjs scripts/require-developer-id.test.mjs && node scripts/verify-server-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@relay/app": "workspace:*",
    "@relay/ui-react": "workspace:*",
    "playwright-core": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "build": {
    "appId": "dev.relay.desktop",
    "productName": "Relay",
    "beforePack": "./scripts/before-pack-ios-preview-sidecar.mjs",
    "afterPack": "./scripts/after-pack-macos-icon.mjs",
    "afterSign": "./scripts/after-sign-ios-preview-sidecar.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/server",
        "to": "server"
      },
      {
        "from": "out/package.json",
        "to": "package.json"
      },
      {
        "from": "out/browsers.json",
        "to": "browsers.json"
      },
      {
        "from": "out/ios-preview",
        "to": "ios-preview"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/relay-icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "binaries": [
        "Contents/Resources/ios-preview/relay-ios-preview"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Relay ${version}"
    }
  },
  "productName": "Relay"
}
